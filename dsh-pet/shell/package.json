{
  "name": "dsh-pet-shell",
  "version": "0.2.2",
  "private": true,
  "description": "dsh-pet 桌宠桌面壳：全屏透明置顶窗加载服务器桌宠页，让宠物活在整个桌面上（点击穿透 + 托盘）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "icu.linhaoting.dsh-pet.shell",
    "productName": "dsh-pet-shell",
    "artifactName": "dsh-pet-shell-${version}-win-${arch}.zip",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "setup.js",
      "icon.png"
    ],
    "win": {
      "target": "zip",
      "icon": "build/icon.png"
    }
  }
}
